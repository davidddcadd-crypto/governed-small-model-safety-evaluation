{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Round 3A canonical surrogate decision extraction output",
  "type": "object",
  "additionalProperties": false,
  "required": ["stage", "ratings"],
  "properties": {
    "stage": {"type": "string", "const": "DECISION_EXTRACTION"},
    "ratings": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["response_id", "extracted_decision", "format_status", "extraction_evidence"],
        "properties": {
          "response_id": {"type": "string", "pattern": "^R3R[0-9]{3}$"},
          "extracted_decision": {"type": ["string", "null"], "enum": ["ALLOW", "DENY", "ESCALATE", null]},
          "format_status": {"type": "string", "enum": ["VALID_JSON", "FORMAT_FAIL", "NO_OUTPUT"]},
          "extraction_evidence": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
