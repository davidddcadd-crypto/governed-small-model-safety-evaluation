{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Round 4A surrogate rater session evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rater_id", "rater_type", "provider", "model", "reasoning",
    "codex_cli_version", "session_id", "stage1_started_at",
    "stage1_completed_at", "stage2_started_at", "stage2_completed_at",
    "stage1_authorization_sha256", "stage2_authorization_sha256",
    "stage1_command", "stage2_command", "stage1_prompt_path",
    "stage2_prompt_path", "stage1_events_path", "stage2_events_path",
    "calibration_sha256", "rubric_sha256", "extraction_packet_sha256",
    "scoring_packet_sha256", "stage1_prompt_sha256", "stage2_prompt_sha256",
    "stage1_events_sha256", "stage2_events_sha256",
    "stage1_raw_output_sha256", "stage2_raw_output_sha256",
    "runtime_extraction_schema_sha256", "runtime_scoring_schema_sha256",
    "tool_calls_observed"
  ],
  "properties": {
    "rater_id": {"type": "string", "minLength": 1},
    "rater_type": {"const": "DAVID_CALIBRATED_AI_SURROGATE"},
    "provider": {"const": "OpenAI"},
    "model": {"const": "gpt-5.6-sol"},
    "reasoning": {"const": "xhigh"},
    "codex_cli_version": {"const": "0.152.0"},
    "session_id": {"type": "string", "minLength": 1},
    "stage1_started_at": {"type": "string", "format": "date-time"},
    "stage1_completed_at": {"type": "string", "format": "date-time"},
    "stage2_started_at": {"type": "string", "format": "date-time"},
    "stage2_completed_at": {"type": "string", "format": "date-time"},
    "stage1_authorization_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "stage2_authorization_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "stage1_command": {"type": "string"},
    "stage2_command": {"type": "string"},
    "stage1_prompt_path": {"type": "string"},
    "stage2_prompt_path": {"type": "string"},
    "stage1_events_path": {"type": "string"},
    "stage2_events_path": {"type": "string"},
    "calibration_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "rubric_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "extraction_packet_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "scoring_packet_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "stage1_prompt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "stage2_prompt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "stage1_events_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "stage2_events_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "stage1_raw_output_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "stage2_raw_output_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "runtime_extraction_schema_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "runtime_scoring_schema_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "tool_calls_observed": {"const": 0}
  }
}
